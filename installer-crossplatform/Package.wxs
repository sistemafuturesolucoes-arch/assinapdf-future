<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="AssinaPDF | Future Solucoes"
    Manufacturer="Future Solucoes"
    Version="0.4.0"
    UpgradeCode="B7D9E2A1-6F43-4C85-9A12-8D5E7B3F2046"
    Scope="perMachine"
    Language="1046">

    <SummaryInformation Description="AssinaPDF CrossPlatform - PDF reader and digital signature" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of AssinaPDF is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AssinaPDFIcon" SourceFile="../public/favicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AssinaPDFIcon" />

    <Feature Id="MainFeature" Title="AssinaPDF" Level="1">
      <ComponentGroupRef Id="PublishedAppFiles" />
      <ComponentRef Id="AssinaPDFStartMenuShortcut" />
      <ComponentRef Id="AssinaPDFDesktopShortcut" />
    </Feature>

  </Package>

  <Fragment>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="FutureAppDirectory" Name="Future Solucoes">
        <Directory Id="INSTALLFOLDER" Name="AssinaPDF" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AssinaPDF" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="AssinaPDFDesktopShortcut" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="AssinaPDF"
          Target="[INSTALLFOLDER]AssinaPDF.MacPrototype.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AssinaPDFIcon" />

        <RegistryValue
          Root="HKCU"
          Key="Software\Future Solucoes\AssinaPDF"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="PublishedAppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**" />
    </ComponentGroup>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="AssinaPDFStartMenuShortcut" Guid="*">
        <Shortcut
          Id="StartMenuShortcut"
          Name="AssinaPDF"
          Target="[INSTALLFOLDER]AssinaPDF.MacPrototype.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AssinaPDFIcon" />

        <RegistryValue
          Root="HKCU"
          Key="Software\Future Solucoes\AssinaPDF"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />

        <RemoveFolder
          Id="RemoveProgramMenuFolder"
          Directory="ApplicationProgramsFolder"
          On="uninstall" />
      </Component>
    </DirectoryRef>

  </Fragment>

</Wix>
