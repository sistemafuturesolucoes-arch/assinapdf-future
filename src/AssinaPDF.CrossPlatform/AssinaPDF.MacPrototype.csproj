<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon Condition="'$(RuntimeIdentifier)' == 'win-x64'">Assets/assinapdf.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaRichEditor" Version="1.3.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="bblanchon.PDFium.macOS" Version="158.0.8125" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8125" />
    <PackageReference Include="SimpleSign.PAdES" Version="0.9.2" />
    <PackageReference Include="PDFsharp" Version="6.2.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="Aspose.PDF.FOSS" Version="26.11.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="logo-future.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\Inter-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Inter-Bold.ttf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="ThirdParty\Danfe.NFe.Core\Danfe.NFe.Core.csproj" />
  </ItemGroup>

  <!--
    A biblioteca DANFE é compilada pelo ProjectReference.
    Impede que seus fontes sejam incluídos também na compilação
    automática do aplicativo, evitando tipos duplicados.
  -->
  <ItemGroup>
    <Compile Remove="ThirdParty\Danfe.NFe.Core\**\*.cs" />
  </ItemGroup></Project>