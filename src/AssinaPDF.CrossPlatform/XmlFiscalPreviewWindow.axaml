<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AssinaPDF.MacPrototype.XmlFiscalPreviewWindow"
        Title="AssinaPDF | Prévia XML Fiscal"
        Width="900" Height="720" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
      <TextBlock x:Name="HeaderText" Text="Importação XML fiscal" FontSize="23" FontWeight="SemiBold" Foreground="#252A34"/>
      <TextBlock x:Name="DescriptionText" Text="Selecione um XML autorizado para validar e visualizar os dados." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,12">
      <Button Content="Selecionar arquivo XML" Click="SelectXml_Click" Padding="16,9" Background="#6741B8" Foreground="White"/>
      <TextBlock x:Name="FileNameText" Grid.Column="1" Text="Nenhum arquivo selecionado" VerticalAlignment="Center" FontSize="12" Foreground="#666D78" TextTrimming="CharacterEllipsis"/>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="9" Padding="14">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="DADOS EXTRAÍDOS E VALIDADOS" FontSize="11" FontWeight="SemiBold" Foreground="#555D69" Margin="0,0,0,10"/>
        <ListBox x:Name="FieldsList" Grid.Row="1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="#34383E" Margin="4,6"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Text="Aguardando arquivo XML." FontSize="11" Foreground="#666D78" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button Grid.Column="1" Content="Fechar" Click="Close_Click" Padding="16,8" Background="#E2E5EA" Foreground="#34383E"/>
    </Grid>
  </Grid>
</Window>