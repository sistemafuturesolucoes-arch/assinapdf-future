<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AssinaPDF.MacPrototype.EditorWindow"
        Title="AssinaPDF | Editor de PDF"
        Width="1440" Height="900"
        MinWidth="1040" MinHeight="680"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#202631">
  <Grid RowDefinitions="68,*,36" ColumnDefinitions="1*">
    <!-- Barra superior inspirada no Typecraft: documento, histórico, zoom e ações. -->
    <Border Grid.Row="0" Background="#171C25" BorderBrush="#343C49"
            BorderThickness="0,0,0,1" Padding="22,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="FUTURE  /  ASSINAPDF STUDIO" FontSize="10"
                     FontWeight="Bold" Foreground="#A78BFA" />
          <TextBlock x:Name="DocumentNameText" Text="Documento.pdf"
                     FontSize="15" FontWeight="SemiBold" Foreground="#F4F5F7"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Content="↶" Click="Undo_Click"
                ToolTip.Tip="Desfazer" Padding="13,8" FontSize="17"
                Background="#252D39" Foreground="#E7EAF0"
                BorderBrush="#3B4554" />
        <Button Grid.Column="2" Content="↷" Click="Redo_Click"
                ToolTip.Tip="Refazer" Padding="13,8" FontSize="17"
                Background="#252D39" Foreground="#E7EAF0"
                BorderBrush="#3B4554" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center">
          <Button Content="−" Click="ZoomOut_Click" Padding="10,7"
                  Background="#252D39" Foreground="#E7EAF0" BorderBrush="#3B4554"/>
          <TextBlock x:Name="EditorZoomText" Text="100%" Width="48"
                     TextAlignment="Center" VerticalAlignment="Center"
                     FontSize="11" FontWeight="SemiBold" Foreground="#D9D2FE"/>
          <Button Content="+" Click="ZoomIn_Click" Padding="10,7"
                  Background="#252D39" Foreground="#E7EAF0" BorderBrush="#3B4554"/>
        </StackPanel>
        <Button Grid.Column="4" Content="Abrir PDF" Click="OpenPdf_Click"
                Padding="16,9" Background="#252D39" Foreground="#F4F5F7"
                BorderBrush="#3B4554" />
        <Button Grid.Column="5" Content="Exportar PDF" Click="SaveAs_Click"
                Padding="18,9" Background="#6D4BC3" Foreground="White"
                BorderThickness="0" FontWeight="SemiBold"/>
      </Grid>
    </Border>

    <!-- Estrutura de três áreas: ferramentas/páginas, documento e propriedades. -->
    <Grid Grid.Row="1" ColumnDefinitions="72,176,*,306" Background="#202631">
      <Border Grid.Column="0" Background="#171C25"
              BorderBrush="#343C49" BorderThickness="0,0,1,0" Padding="8,14">
        <StackPanel Spacing="10">
          <TextBlock Text="FERRAMENTAS" FontSize="8" FontWeight="Bold"
                     Foreground="#7F8998" HorizontalAlignment="Center"
                     Margin="0,0,0,5"/>
          <Button x:Name="SelectModeButton" Content="↖"
                  Click="SelectMode_Click" Height="48" FontSize="22"
                  Background="#3B2B62" Foreground="#D9CCFF"
                  BorderBrush="#8063C7"
                  ToolTip.Tip="Selecionar e manipular texto"/>
          <TextBlock Text="Selecionar" FontSize="9" Foreground="#C5CBD5"
                     HorizontalAlignment="Center"/>
          <Button x:Name="AddTextModeButton" Content="T"
                  Click="AddTextMode_Click" Height="48" FontSize="22"
                  Background="#252D39" Foreground="#E7EAF0"
                  BorderBrush="#3B4554"
                  ToolTip.Tip="Inserir texto na página"/>
          <TextBlock Text="Texto" FontSize="9" Foreground="#C5CBD5"
                     HorizontalAlignment="Center"/>
          <Button x:Name="AutoTextBoxesModeButton" Content="▤"
                  Click="AutoTextBoxesMode_Click" Height="48" FontSize="20"
                  Background="#252D39" Foreground="#E7EAF0"
                  BorderBrush="#3B4554"
                  ToolTip.Tip="Mostrar caixas de texto detectadas"/>
          <TextBlock Text="Blocos" FontSize="9" Foreground="#C5CBD5"
                     HorizontalAlignment="Center"/>
          <Button x:Name="AddImageModeButton" Content="▧"
                  Click="AddImageMode_Click" Height="48" FontSize="21"
                  Background="#252D39" Foreground="#E7EAF0"
                  BorderBrush="#3B4554"
                  ToolTip.Tip="Inserir imagem no PDF"/>
          <TextBlock Text="Imagem" FontSize="9" Foreground="#C5CBD5"
                     HorizontalAlignment="Center"/>
          <Button x:Name="RectangleModeButton" Content="□"
                  Click="RectangleMode_Click" Height="48" FontSize="23"
                  Background="#252D39" Foreground="#E7EAF0"
                  BorderBrush="#3B4554"
                  ToolTip.Tip="Desenhar retângulo no PDF"/>
          <TextBlock Text="Forma" FontSize="9" Foreground="#C5CBD5"
                     HorizontalAlignment="Center"/>
          <Button x:Name="EllipseModeButton" Content="◯"
                  Click="EllipseMode_Click" Height="48" FontSize="23"
                  Background="#252D39" Foreground="#E7EAF0"
                  BorderBrush="#3B4554"
                  ToolTip.Tip="Desenhar elipse no PDF"/>
          <TextBlock Text="Elipse" FontSize="9" Foreground="#C5CBD5"
                     HorizontalAlignment="Center"/>
          <Border Height="1" Background="#343C49" Margin="4,8"/>
          <TextBlock Text="ATALHOS" FontSize="8" FontWeight="Bold"
                     Foreground="#7F8998" HorizontalAlignment="Center"/>
          <TextBlock Text="V  Selecionar&#10;T  Texto&#10;Ctrl+Z  Desfazer&#10;Ctrl+roda  Zoom"
                     FontSize="9" Foreground="#9AA4B2"
                     TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="#1D232E"
              BorderBrush="#343C49" BorderThickness="0,0,1,0" Padding="10,14">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <StackPanel Spacing="3">
            <TextBlock Text="PÁGINAS" FontSize="10" FontWeight="Bold"
                       Foreground="#E5E7EB"/>
            <TextBlock Text="Navegue pelo documento" FontSize="9"
                       Foreground="#8792A2"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EditorThumbnailsPanel" Spacing="10"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#252C37" Padding="24,20">
        <ScrollViewer x:Name="EditorDocumentScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PointerWheelChanged="EditorDocumentScrollViewer_PointerWheelChanged"
                      Focusable="True">
          <StackPanel x:Name="EditorPagesPanel" Spacing="24"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"/>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="3" Background="#1D232E"
              BorderBrush="#343C49" BorderThickness="1,0,0,0" Padding="16,16">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="PROPRIEDADES" FontSize="11"
                         FontWeight="Bold" Foreground="#F3F4F6"/>
              <TextBlock Text="Selecione um elemento para editar"
                         FontSize="9" Foreground="#8792A2"/>
            </StackPanel>
            <Border Height="1" Background="#343C49"/>
            <TextBlock Text="ELEMENTO SELECIONADO" FontSize="9"
                       FontWeight="Bold" Foreground="#A78BFA"/>
            <TextBlock x:Name="SelectedTextLabel"
                       Text="Nenhum texto selecionado"
                       IsVisible="True" FontSize="11" Foreground="#E5E7EB"
                       TextWrapping="Wrap" MaxHeight="110"/>
            <StackPanel Spacing="7">
              <Button x:Name="EditSelectedTextButton" Content="Editar conteúdo"
                      Click="EditSelectedText_Click" IsVisible="False"
                      HorizontalAlignment="Stretch" Padding="12,9"
                      Background="#6D4BC3" Foreground="White"
                      BorderThickness="0"/>
              <Button x:Name="DeleteSelectedTextButton" Content="Excluir texto"
                      Click="DeleteSelectedText_Click" IsVisible="False"
                      HorizontalAlignment="Stretch" Padding="12,9"
                      Background="#482B35" Foreground="#FFC5CC"
                      BorderBrush="#75404B"/>
            </StackPanel>
            <StackPanel x:Name="ShapePropertiesPanel" IsVisible="False" Spacing="9">
              <Border Height="1" Background="#343C49"/>
              <TextBlock Text="APARÊNCIA DA FORMA" FontSize="9"
                         FontWeight="Bold" Foreground="#A78BFA"/>
              <TextBlock Text="Preenchimento" FontSize="10"
                         Foreground="#C5CBD5"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox x:Name="ShapeFillColorTextBox" Text="#FFFFFF"
                         FontFamily="Consolas" FontSize="11"
                         VerticalContentAlignment="Center"
                         Watermark="#RRGGBB"
                         KeyUp="ShapeFillColorTextBox_KeyUp"/>
                <Button Grid.Column="1" Content="Aplicar"
                        Click="ApplyShapeFillColor_Click"
                        Padding="9,5" Background="#6D4BC3"
                        Foreground="White" BorderThickness="0"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Tag="#000000" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#000000"
                        BorderBrush="#667085" ToolTip.Tip="Preto"/>
                <Button Tag="#FFFFFF" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#FFFFFF"
                        BorderBrush="#667085" ToolTip.Tip="Branco"/>
                <Button Tag="#1F2937" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#1F2937"
                        BorderBrush="#667085" ToolTip.Tip="Grafite"/>
                <Button Tag="#DC2626" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#DC2626"
                        BorderBrush="#667085" ToolTip.Tip="Vermelho"/>
                <Button Tag="#EA580C" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#EA580C"
                        BorderBrush="#667085" ToolTip.Tip="Laranja"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Tag="#CA8A04" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#CA8A04"
                        BorderBrush="#667085" ToolTip.Tip="Amarelo"/>
                <Button Tag="#16A34A" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#16A34A"
                        BorderBrush="#667085" ToolTip.Tip="Verde"/>
                <Button Tag="#2563EB" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#2563EB"
                        BorderBrush="#667085" ToolTip.Tip="Azul"/>
                <Button Tag="#7C3AED" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#7C3AED"
                        BorderBrush="#667085" ToolTip.Tip="Violeta"/>
                <Button Tag="#DB2777" Click="ShapeColorSwatch_Click"
                        Width="25" Height="25" Padding="0" Background="#DB2777"
                        BorderBrush="#667085" ToolTip.Tip="Rosa"/>
              </StackPanel>
              <TextBlock x:Name="ShapeOpacityValueText" Text="Opacidade · 100%"
                         FontSize="10" Foreground="#C5CBD5"/>
              <Slider x:Name="ShapeOpacitySlider" Minimum="0.05"
                      Maximum="1" Value="1" SmallChange="0.05"
                      LargeChange="0.1"
                      ValueChanged="ShapeOpacitySlider_ValueChanged"
                      PointerReleased="ShapeOpacitySlider_PointerReleased"
                      KeyUp="ShapeOpacitySlider_KeyUp"/>
            </StackPanel>
            <Border Height="1" Background="#343C49"/>
            <TextBlock Text="FORMATAÇÃO" FontSize="9" FontWeight="Bold"
                       Foreground="#A78BFA"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <ContentControl x:Name="EditorFormattingToolbarHost" IsVisible="False"/>
            </ScrollViewer>
            <ContentControl x:Name="EditorInlineEditorHost" IsVisible="False"/>
            <Border Height="1" Background="#343C49"/>
            <StackPanel x:Name="EditorInstructionsPanel" Spacing="8">
              <TextBlock Text="COMO EDITAR" FontSize="9" FontWeight="Bold"
                         Foreground="#A78BFA"/>
              <TextBlock Text="• Clique ou arraste sobre o texto para selecionar.&#10;&#10;• Use “Editar conteúdo” para alterar o texto e sua formatação.&#10;&#10;• Escolha T e clique na página para inserir um novo texto.&#10;&#10;• Use a roda do mouse para navegar e Ctrl + roda para ajustar o zoom."
                         FontSize="10" Foreground="#AAB2BF"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#171C25"
            BorderBrush="#343C49" BorderThickness="0,1,0,0" Padding="16,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="EditorStatusText"
                   Text="O documento original permanece preservado. As alterações são feitas em uma cópia de trabalho."
                   FontSize="10" Foreground="#AAB2BF"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="1" Content="Fechar editor" Click="CloseEditor_Click"
                Padding="12,4" Background="#252D39" Foreground="#E7EAF0"
                BorderBrush="#3B4554" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Campos auxiliares mantidos para compatibilidade com busca/substituição. -->
    <StackPanel IsVisible="False">
      <TextBox x:Name="SearchTextBox"/>
      <TextBox x:Name="ReplaceTextBox"/>
    </StackPanel>
  </Grid>
</Window>