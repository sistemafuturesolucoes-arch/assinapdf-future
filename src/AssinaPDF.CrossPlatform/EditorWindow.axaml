<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AssinaPDF.MacPrototype.EditorWindow"
        Title="AssinaPDF | Editor de PDF"
        Width="900" Height="640"
        MinWidth="680" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
  <Grid RowDefinitions="64,48,*,38">
    <Border Grid.Row="0" Background="#292D36" Padding="18,8">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Editor de PDF" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="DocumentNameText" Text="Cópia de trabalho" FontSize="11" Foreground="#D5D8DE"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Salvar como novo PDF..." Click="SaveAs_Click"
                VerticalAlignment="Center" Padding="16,9"
                Background="#FFFFFF" Foreground="#292D36" BorderThickness="0"/>
        <Button Grid.Column="2" Content="Fechar editor" Click="CloseEditor_Click"
                VerticalAlignment="Center" Padding="16,9"
                Background="#555C68" Foreground="White" BorderThickness="0"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9DCE0" BorderThickness="0,0,0,1" Padding="10,5">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Button Content="↶" FontSize="20" Width="38" Height="32" Click="Undo_Click" ToolTip.Tip="Desfazer"/>
          <Button Content="↷" FontSize="20" Width="38" Height="32" Click="Redo_Click" ToolTip.Tip="Refazer"/>
          <Border Width="1" Height="25" Background="#D9DCE0" Margin="3,0"/>
          <TextBlock Text="Localizar:" VerticalAlignment="Center" Foreground="#555B63"/>
          <TextBox x:Name="SearchTextBox" Width="170" PlaceholderText="Texto existente"/>
          <TextBox x:Name="ReplaceTextBox" Width="170" PlaceholderText="Substituir por"/>
          <Button Content="Substituir tudo" Click="ReplaceText_Click" Padding="12,6"/>
          <TextBlock Text="Clique uma vez em um texto para selecioná-lo."
                     VerticalAlignment="Center" Foreground="#666D77" Margin="8,0,0,0"/>
          <TextBlock x:Name="SelectedTextLabel" Text="" IsVisible="False"
                     VerticalAlignment="Center" Foreground="#292D36" FontWeight="SemiBold"/>
          <Button x:Name="EditSelectedTextButton" Content="Editar seleção"
                  IsVisible="False" Click="EditSelectedText_Click" Padding="12,6"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Background="#D9DCE0" Padding="12">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="EditorPagesPanel" Spacing="18" HorizontalAlignment="Center"/>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="3" Background="#E7E9ED" Padding="12,4">
      <TextBlock x:Name="EditorStatusText"
                 Text="O documento está aberto em uma cópia de trabalho permanente. O original permanece preservado."
                 FontSize="11" Foreground="#555B63" VerticalAlignment="Center"/>
    </Border>
  </Grid>
</Window>
