<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AssinaPDF.MacPrototype.ConverterWindow"
        Title="AssinaPDF | Converter arquivos"
        Width="820" Height="650"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
      <TextBlock Text="Central de conversão" FontSize="26" FontWeight="SemiBold" Foreground="#252A34"/>
      <TextBlock Text="Conversões locais. Seus arquivos permanecem no computador." FontSize="13" Foreground="#737B87"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
              <TextBlock Text="Juntar arquivos PDF" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
              <TextBlock Text="Abra o organizador visual para adicionar PDFs, visualizar páginas em miniatura e preparar a sequência do documento final." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Grid.RowSpan="2" Content="Abrir organizador" Click="MergePdfs_Click" VerticalAlignment="Center" Background="#6741B8" Foreground="White" Padding="16,10"/>
            <TextBlock x:Name="MergeStatusText" Grid.Row="2" Text="Nenhum arquivo selecionado." FontSize="11" Foreground="#747B86" Margin="0,12,0,0"/>
          </Grid>
        </Border>
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
              <TextBlock Text="Imagem para PDF" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
              <TextBlock Text="Converta JPG, JPEG, PNG e BMP. Cada imagem será colocada em uma página, ajustada proporcionalmente." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Grid.RowSpan="2" Content="Selecionar imagens" Click="ImagesToPdf_Click" VerticalAlignment="Center" Background="#6741B8" Foreground="White" Padding="16,10"/>
            <TextBlock x:Name="ImagesStatusText" Grid.Row="2" Text="Nenhuma imagem selecionada." FontSize="11" Foreground="#747B86" Margin="0,12,0,0"/>
          </Grid>
        </Border>
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
              <TextBlock Text="PDF para JPG" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
              <TextBlock Text="Exporte cada página do PDF como uma imagem JPG separada." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Grid.RowSpan="2" Content="Selecionar PDF e exportar" Click="PdfToJpg_Click" VerticalAlignment="Center" Background="#6741B8" Foreground="White" Padding="16,10"/>
            <TextBlock x:Name="PdfToJpgStatusText" Grid.Row="2" Text="Nenhum PDF selecionado." FontSize="11" Foreground="#747B86" Margin="0,12,0,0"/>
          </Grid>
        </Border>
        <Border Background="#ECEEF2" CornerRadius="8" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="Próximas conversões" FontSize="13" FontWeight="SemiBold" Foreground="#454B55"/>
            <TextBlock Text="XML fiscal para PDF • PDF para Word • Word para PDF • Excel para Word/PDF" FontSize="12" Foreground="#747B86" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
      <TextBlock x:Name="StatusText" Text="Pronto para converter." FontSize="11" Foreground="#666D78" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Fechar" Click="Close_Click" Padding="18,8" Background="#E2E5EA" Foreground="#34383E"/>
    </Grid>
  </Grid>
</Window>