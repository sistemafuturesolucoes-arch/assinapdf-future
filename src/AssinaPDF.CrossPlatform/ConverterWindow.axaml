<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AssinaPDF.MacPrototype.ConverterWindow"
        Title="AssinaPDF | Converter arquivos"
        Width="820" Height="650" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,20">
      <TextBlock Text="Central de conversão" FontSize="26" FontWeight="SemiBold" Foreground="#252A34"/>
      <TextBlock Text="Escolha a conversão para abrir o editor. Seus arquivos permanecem no computador." FontSize="13" Foreground="#737B87"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
              <TextBlock Text="Imagem para PDF" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
              <TextBlock Text="Adicione várias imagens, visualize, reorganize e reúna tudo em um único PDF, com uma imagem por página." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Grid.RowSpan="2" Content="Abrir editor de imagens" Click="ImagesToPdf_Click" VerticalAlignment="Center" Background="#6741B8" Foreground="White" Padding="16,10"/>
            <TextBlock x:Name="ImagesStatusText" Grid.Row="2" Text="Editor de imagens pronto." FontSize="11" Foreground="#747B86" Margin="0,12,0,0"/>
          </Grid>
        </Border>
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
              <TextBlock Text="PDF para imagens" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
              <TextBlock Text="Adicione vários PDFs, visualize e organize todas as páginas antes de exportar cada uma como JPG, PNG ou TIFF para uma única pasta." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Grid.RowSpan="2" Content="Abrir editor de PDF" Click="PdfToJpg_Click" VerticalAlignment="Center" Background="#6741B8" Foreground="White" Padding="16,10"/>
            <TextBlock x:Name="PdfToJpgStatusText" Grid.Row="2" Text="Editor de PDF pronto." FontSize="11" Foreground="#747B86" Margin="0,12,0,0"/>
          </Grid>
        </Border>
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Grid.Row="0" Spacing="4">
              <TextBlock Text="XML de NF-e para DANFE" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
              <TextBlock Text="Importe XMLs de NF-e autorizadas, confira os dados fiscais e prepare a geração do DANFE em PDF." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Grid.RowSpan="2" Content="Importar XML de NF-e" Click="NfeToDanfe_Click" VerticalAlignment="Center" Background="#6741B8" Foreground="White" Padding="16,10"/>
            <TextBlock x:Name="NfeStatusText" Grid.Row="2" Text="Leitura local de XMLs pronta." FontSize="11" Foreground="#747B86" Margin="0,12,0,0"/>
          </Grid>
        </Border>
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel Spacing="9">
            <TextBlock Text="XML de NFC-e para DANFCE" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
            <TextBlock Text="Importe vários XMLs de NFC-e de empresas diferentes, gere os DANFCEs em PDF com QR Code e visualize, organize e exporte em lote." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            <Button Content="Importar XML de NFC-e" Click="NfceImport_Click" HorizontalAlignment="Left" Background="#6741B8" Foreground="White" Padding="16,9"/>
            <TextBlock x:Name="NfceStatusText" Text="Central de NFC-e com geração e pré-visualização de DANFCE em PDF." FontSize="11" Foreground="#747B86" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel Spacing="9">
            <TextBlock Text="XML de CT-e para DACTE" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
            <TextBlock Text="Importe vários CT-e autorizados modelo 57, gere DACTEs em PDF A4, visualize páginas, agrupe por emitente e exporte individualmente, consolidados ou em ZIP." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            <Button Content="Importar XML de CT-e" Click="CteImport_Click" HorizontalAlignment="Left" Background="#6741B8" Foreground="White" Padding="16,9"/>
            <TextBlock x:Name="CteStatusText" Text="Central de CT-e com geração e pré-visualização de DACTE em PDF A4." FontSize="11" Foreground="#747B86" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel Spacing="9">
            <TextBlock Text="XML de NFS-e Nacional para DANFSe" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
            <TextBlock Text="Importe vários XMLs autorizados do Padrão Nacional, gere os DANFSe em PDF, visualize na aplicação e exporte individualmente ou em um único PDF." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            <Button Content="Importar XMLs de NFS-e Nacional" Click="NfseImport_Click" HorizontalAlignment="Left" Background="#6741B8" Foreground="White" Padding="16,9"/>
            <TextBlock x:Name="NfseStatusText" Text="Central de NFS-e Nacional com conversão em lote e pré-visualização de DANFSe." FontSize="11" Foreground="#747B86" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="10" Padding="18">
          <StackPanel Spacing="9">
            <TextBlock Text="XML de MDF-e para DAMDFE" FontSize="18" FontWeight="SemiBold" Foreground="#292D36"/>
            <TextBlock Text="Importe MDF-e autorizados, gere o DAMDFE em PDF, visualize páginas, ajuste o zoom e exporte individualmente ou consolide vários documentos em um único PDF." FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
            <Button Content="Importar XML de MDF-e" Click="MdfeImport_Click" HorizontalAlignment="Left" Background="#6741B8" Foreground="White" Padding="16,9"/>
            <TextBlock x:Name="MdfeStatusText" Text="Central de MDF-e com geração e pré-visualização de DAMDFE em PDF." FontSize="11" Foreground="#747B86" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Background="#ECEEF2" CornerRadius="8" Padding="14">
          <StackPanel Spacing="5">
            <TextBlock Text="Em desenvolvimento" FontSize="13" FontWeight="SemiBold" Foreground="#454B55"/>
            <TextBlock Text="PDF → Word • Word → PDF • Excel → Word/PDF" FontSize="12" Foreground="#747B86" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
      <TextBlock x:Name="StatusText" Text="Pronto para converter." FontSize="11" Foreground="#666D78" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Fechar" Click="Close_Click" Padding="18,8" Background="#E2E5EA" Foreground="#34383E"/>
    </Grid>
  </Grid>
</Window>