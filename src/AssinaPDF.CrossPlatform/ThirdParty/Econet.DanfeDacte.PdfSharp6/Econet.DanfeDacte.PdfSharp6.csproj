<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Zion.NFe.Danfe</AssemblyName>
    <RootNamespace>Zion.NFe.Danfe</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Econet.DanfeDacte.Source\Zion.NFe.Danfe\**\*.cs"
             Exclude="..\Econet.DanfeDacte.Source\Zion.NFe.Danfe\PdfClownCompat.cs;..\Econet.DanfeDacte.Source\Zion.NFe.Danfe\**\obj\**;..\Econet.DanfeDacte.Source\Zion.NFe.Danfe\**\bin\**" />
    <Compile Include="PdfClownCompat.PdfSharp6.cs" />
    <EmbeddedResource Include="..\Econet.DanfeDacte.Source\Zion.NFe.Danfe\Fonts\*.ttf"
                      LogicalName="Zion.NFe.Danfe.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>
</Project>
