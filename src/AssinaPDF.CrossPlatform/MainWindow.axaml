<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AssinaPDF.MacPrototype.MainWindow"
        Title="AssinaPDF | Future Soluções"
        Width="1280" Height="850"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F2F3F5">

  <Grid RowDefinitions="82,42,58,34,*,42">

    <!-- CABEÇALHO -->
    <Border Grid.Row="0" Background="#E6E8EB" Padding="22,10">
      <Grid ColumnDefinitions="260,*">
        <Image x:Name="FutureLogo"
               Grid.Column="0"
               Width="220" Height="60"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Stretch="Uniform"/>

        <TextBlock Grid.Column="1"
                   Text="Assinatura digital de documentos PDF"
                   FontSize="17"
                   Foreground="#454951"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"/>
      </Grid>
    </Border>

    <!-- SERVIÇOS -->
    <Grid Grid.Row="1"
          ColumnDefinitions="*,*,*"
          Background="#F2F3F5">

      <Button Grid.Column="0"
              Content="Certificado Digital · Emissão e renovação"
              Background="#E8EAED"
              Foreground="#34383E"
              BorderThickness="0"
              CornerRadius="0"
              Margin="1"
              Click="OpenPromoLink_Click"/>

      <Button Grid.Column="1"
              Content="SPC Brasil Â· Consultas para empresas"
              Background="#E8EAED"
              Foreground="#34383E"
              BorderThickness="0"
              CornerRadius="0"
              Margin="1"
              Click="OpenPromoLink_Click"/>

      <Button Grid.Column="2"
              Content="Sistema de Notas · Emissão fiscal em nuvem"
              Background="#E8EAED"
              Foreground="#34383E"
              BorderThickness="0"
              CornerRadius="0"
              Margin="1"
              Click="OpenPromoLink_Click"/>
    </Grid>

    <!-- FERRAMENTAS -->
    <Border Grid.Row="2" Background="#E0E3E7" Padding="12,7">
      <StackPanel Orientation="Horizontal"
                  Spacing="9"
                  VerticalAlignment="Center">

        <Button Content="Abrir PDF"
                Padding="16,8"
                Background="#5C626C"
                Foreground="White"
                Click="OpenPdf_Click"/>

        <Button x:Name="SignButton"
                Content="Assinar PDF"
                Click="SignPdf_Click"
                Padding="16,8"
                Background="#5C626C"
                Foreground="White"
                IsEnabled="False"/>

        <Button x:Name="ValidateButton"
                Content="Validar assinatura"
                Click="ValidatePdf_Click"
                Padding="16,8"
                Background="#5C626C"
                Foreground="White"
                IsEnabled="False"/>

        <TextBlock Text="Certificado do sistema:"
                   VerticalAlignment="Center"
                   Foreground="#34383E"
                   Margin="12,0,0,0"/>

        <ComboBox x:Name="CertificatePicker"
                  Width="310"
                  MinHeight="34"
                  VerticalAlignment="Center"
                  PlaceholderText="Selecione um certificado"
                  SelectionChanged="CertificatePicker_SelectionChanged"/>

        <Button Content="Atualizar certificados"
                Padding="12,8"
                Background="#5C626C"
                Foreground="White"
                Click="RefreshCertificates_Click"/>

        <TextBox x:Name="SigningReasonTextBox"
                 Width="250"
                 VerticalAlignment="Center"
                 Watermark="Motivo da assinatura (opcional)"/>

      </StackPanel>
    </Border>
    <!-- DOCUMENTO -->
    <Border Grid.Row="3" Background="#F8F9FA"
            Padding="14,5">

      <TextBlock x:Name="SelectedFileText"
                 Text="Nenhum documento selecionado."
                 Foreground="#555B63"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"/>
    </Border>

    <!-- VISUALIZADOR PDF COM MINIATURAS E ROLAGEM CONTÍNUA -->
    <Border Grid.Row="4" Background="#D9DCE0">
      <Grid ColumnDefinitions="164,*">
        <Border Grid.Column="0"
                Background="#E7E9EC"
                BorderBrush="#C9CDD2"
                BorderThickness="0,0,1,0">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Text="PÁGINAS"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#555B63"
                       Margin="12,12,8,8"/>
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="HomeThumbnailsPanel"
                          Spacing="8"
                          Margin="8,0,8,10"/>
            </ScrollViewer>
          </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="#AEB3BA"
                Margin="10"
                BorderBrush="#C9CDD2"
                BorderThickness="1">
          <ScrollViewer x:Name="PdfScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        IsVisible="False"
                        PointerPressed="PdfScrollViewer_PointerPressed"
                        PointerMoved="PdfScrollViewer_PointerMoved"
                        PointerReleased="PdfScrollViewer_PointerReleased"
                        PointerWheelChanged="PdfScrollViewer_PointerWheelChanged">
            <StackPanel x:Name="PdfPagesPanel"
                        Spacing="18"
                        HorizontalAlignment="Center"
                        Margin="18"/>
          </ScrollViewer>

          <StackPanel x:Name="ViewerPlaceholder"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="12">
            <TextBlock Text="AssinaPDF"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#555B63"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Abra um documento PDF para visualizar."
                       FontSize="15"
                       Foreground="#777D85"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Visualização fornecida pelo motor PDFium."
                       FontSize="12"
                       Foreground="#888E96"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- STATUS -->
    <Border Grid.Row="5" Background="#E0E3E7" Padding="14,5">

      <Grid ColumnDefinitions="*,Auto">

        <TextBlock x:Name="StatusText"
                   Text="Carregando certificados digitais..."
                   Foreground="#454951"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>

        <TextBlock Grid.Column="1"
                   Text="Future Soluções"
                   Foreground="#555B63"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"/>
      </Grid>
    </Border>

  </Grid>
</Window>