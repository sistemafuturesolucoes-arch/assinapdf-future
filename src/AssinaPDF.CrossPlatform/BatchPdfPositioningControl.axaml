<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AssinaPDF.MacPrototype.BatchPdfPositioningControl">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
      <TextBlock Text="VISUALIZAÇÃO E POSICIONAMENTO" FontSize="11" FontWeight="SemiBold"
                 Foreground="#555D69" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="−" Click="ZoomOut_Click" Padding="10,4"/>
      <TextBlock Grid.Column="2" x:Name="ZoomText" Text="100%" VerticalAlignment="Center"
                 HorizontalAlignment="Center" MinWidth="48"/>
      <Button Grid.Column="3" Content="+" Click="ZoomIn_Click" Padding="10,4"/>
      <Button Grid.Column="4" Content="Ajustar" Click="FitPage_Click" Padding="10,4"/>
      <Button Grid.Column="5" Content="Limpar posições" Click="ClearPositions_Click" Padding="10,4"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="92,*" ColumnSpacing="8">
      <Border Grid.Column="0" Background="#F0F1F4" CornerRadius="6" Padding="5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ThumbnailsPanel" Spacing="6"/>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Background="#D9DBE2" CornerRadius="6" Padding="8">
        <ScrollViewer x:Name="PdfScrollViewer" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <Border Background="White" Padding="8" HorizontalAlignment="Center">
            <Grid x:Name="PdfPageSurface"
                  PointerPressed="PdfPageSurface_PointerPressed"
                  PointerMoved="PdfPageSurface_PointerMoved"
                  PointerReleased="PdfPageSurface_PointerReleased">
              <Image x:Name="PdfPageImage" Stretch="Uniform"/>
              <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False"/>
            </Grid>
          </Border>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock x:Name="PreviewStatusText" Text="Selecione um PDF para visualizar e marcar as posições."
                 FontSize="10" Foreground="#555D69" VerticalAlignment="Center"
                 TextWrapping="Wrap"/>
      <TextBlock Grid.Column="1" x:Name="PageIndicator" Text="Página —"
                 FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</UserControl>