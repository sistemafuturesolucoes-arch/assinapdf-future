<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AssinaPDF.MacPrototype.BatchPdfPositioningControl">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4">
      <TextBlock Text="VISUALIZAÇÃO DO PDF" FontSize="10" FontWeight="SemiBold"
                 Foreground="#555D69" VerticalAlignment="Center"/>
      <Button Grid.Column="1" x:Name="PreviousPageButton" Content="‹" ToolTip.Tip="Página anterior"
              Click="PreviousPage_Click" Padding="8,3" IsEnabled="False"/>
      <TextBlock Grid.Column="2" x:Name="PageIndicator" Text="Página —" FontSize="10"
                 VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="62"/>
      <Button Grid.Column="3" x:Name="NextPageButton" Content="›" ToolTip.Tip="Próxima página"
              Click="NextPage_Click" Padding="8,3" IsEnabled="False"/>
      <Button Grid.Column="4" Content="−" Click="ZoomOut_Click" Padding="8,3"/>
      <TextBlock Grid.Column="5" x:Name="ZoomText" Text="100%" FontSize="10"
                 VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="42"/>
      <Button Grid.Column="6" Content="+" Click="ZoomIn_Click" Padding="8,3"/>
      <Button Grid.Column="7" Content="Limpar" ToolTip.Tip="Limpar posições deste PDF"
              Click="ClearPositions_Click" Padding="8,3"/>
    </Grid>
    <Border Grid.Row="1" Background="#D9DBE2" CornerRadius="6" Padding="6">
      <ScrollViewer x:Name="PdfScrollViewer" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <Border Background="White" Padding="6" HorizontalAlignment="Center">
          <Grid x:Name="PdfPageSurface"
                PointerPressed="PdfPageSurface_PointerPressed"
                PointerMoved="PdfPageSurface_PointerMoved"
                PointerReleased="PdfPageSurface_PointerReleased">
            <Image x:Name="PdfPageImage" Stretch="Uniform"/>
            <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False"/>
          </Grid>
        </Border>
      </ScrollViewer>
    </Border>
    <TextBlock Grid.Row="2" x:Name="PreviewStatusText"
               Text="Selecione um PDF para visualizar e marcar as posições."
               FontSize="10" Foreground="#555D69" VerticalAlignment="Center"
               TextWrapping="Wrap"/>
  </Grid>
</UserControl>