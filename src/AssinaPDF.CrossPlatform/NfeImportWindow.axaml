<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:AssinaPDF.MacPrototype.Services"
        x:Class="AssinaPDF.MacPrototype.NfeImportWindow"
        Title="AssinaPDF | Central XML Fiscal"
        Width="960" Height="650" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6">
  <Grid RowDefinitions="Auto,*,Auto" Margin="14">
    <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,10">
      <TextBlock Text="Central XML Fiscal · NF-e" FontSize="22" FontWeight="SemiBold" Foreground="#252A34"/>
      <TextBlock Text="Importe XMLs autorizados, confira os dados e gere o DANFE. Os arquivos originais permanecem no computador."
                 FontSize="12" Foreground="#737B87" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="250,*" ColumnSpacing="10">
      <Border Grid.Column="0" Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="6">
            <Button Content="Adicionar XMLs" Click="AddXml_Click" Background="#6741B8" Foreground="White" Padding="10,8"/>
            <TextBlock x:Name="CountText" Text="Nenhum XML adicionado" FontSize="11" Foreground="#737B87"/>
          </StackPanel>
          <ListBox x:Name="DocumentsList" Grid.Row="1" Margin="0,8,0,8"
                   SelectionChanged="DocumentsList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="services:NfeDocumentSummary">
                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="11"
                           Foreground="#34383E" Margin="3,5"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Spacing="6">
            <Button Content="Remover selecionado" Click="RemoveSelected_Click" Padding="8,7"
                    Background="#E7E9ED" Foreground="#34383E"/>
            <Button Content="Limpar lista" Click="ClearList_Click" Padding="8,7"
                    Background="#F4E9E9" Foreground="#8A3D3D"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="Documento selecionado" FontSize="16" FontWeight="SemiBold" Foreground="#292D36"/>
            <TextBlock x:Name="SelectionHint" Text="Selecione um XML na lista para conferir os dados."
                       FontSize="11" Foreground="#737B87" TextWrapping="Wrap"/>
            <Button Content="Gerar e exportar DANFE PDF" Click="ExportDanfe_Click"
                    HorizontalAlignment="Left" Padding="12,7"
                    Background="#6741B8" Foreground="White"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="DetailsText" Text="Nenhum documento selecionado."
                       FontSize="12" Foreground="#454B55" TextWrapping="Wrap" LineHeight="19"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Text="Aguardando XML de NF-e." FontSize="10"
                 Foreground="#666D78" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button Grid.Column="1" Content="Fechar" Click="Close_Click" Padding="16,7"
              Background="#E2E5EA" Foreground="#34383E"/>
    </Grid>
  </Grid>
</Window>